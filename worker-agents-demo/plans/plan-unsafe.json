{
  "format_version": "1.2",
  "terraform_version": "1.7.0",
  "resource_changes": [
    {
      "address": "aws_db_instance.orders",
      "type": "aws_db_instance",
      "name": "orders",
      "change": {
        "actions": ["delete", "create"],
        "before": { "identifier": "orders-prod", "engine": "postgres", "allocated_storage": 500, "skip_final_snapshot": false },
        "after": { "identifier": "orders-prod", "engine": "postgres", "allocated_storage": 100, "skip_final_snapshot": true }
      }
    },
    {
      "address": "aws_security_group_rule.ssh_open",
      "type": "aws_security_group_rule",
      "name": "ssh_open",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": { "type": "ingress", "from_port": 22, "to_port": 22, "protocol": "tcp", "cidr_blocks": ["0.0.0.0/0"] }
      }
    },
    {
      "address": "aws_iam_policy.admin_all",
      "type": "aws_iam_policy",
      "name": "admin_all",
      "change": {
        "actions": ["create"],
        "before": null,
        "after": { "name": "admin-all", "policy": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":\"*\",\"Resource\":\"*\"}]}" }
      }
    },
    {
      "address": "aws_s3_bucket.customer_exports",
      "type": "aws_s3_bucket",
      "name": "customer_exports",
      "change": {
        "actions": ["update"],
        "before": { "bucket": "customer-exports", "acl": "private" },
        "after": { "bucket": "customer-exports", "acl": "public-read" }
      }
    }
  ]
}
